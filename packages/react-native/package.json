  },
  "peerDependencies": {
    "@react-native-firebase/app": ">=24.0.0",
    "@react-native-firebase/firestore": ">=24.0.0",
    "effect": "catalog:",
    "effect-firebase": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
